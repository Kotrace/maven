<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.kotrace</groupId>
  <artifactId>kotrace-bom</artifactId>
  <version>0.5.0</version>
  <packaging>pom</packaging>
  <name>kotrace-bom</name>
  <description>Bill of materials aligning the versions of every kotrace module.</description>
  <url>https://github.com/Kotrace/kotrace</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>kotrace</id>
      <name>Kotrace</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/Kotrace/kotrace.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Kotrace/kotrace.git</developerConnection>
    <url>https://github.com/Kotrace/kotrace</url>
  </scm>
  <properties>
    <kotrace.git.commit>eb03a1534a5761b2a7478c063c5fbdffa215f947</kotrace.git.commit>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.kotrace</groupId>
        <artifactId>kotrace</artifactId>
        <version>0.5.0</version>
      </dependency>
      <dependency>
        <groupId>dev.kotrace</groupId>
        <artifactId>kotrace-okhttp</artifactId>
        <version>0.5.0</version>
      </dependency>
      <dependency>
        <groupId>dev.kotrace</groupId>
        <artifactId>kotrace-room</artifactId>
        <version>0.5.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
