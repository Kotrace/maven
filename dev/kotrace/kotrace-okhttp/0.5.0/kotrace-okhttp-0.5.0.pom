  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.kotrace</groupId>
  <artifactId>kotrace-okhttp</artifactId>
  <version>0.5.0</version>
  <name>kotrace-okhttp</name>
  <description>kotrace instrumentation for OkHttp: one span per call execution and traceparent injection.</description>
  <url>https://github.com/Kotrace/kotrace</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>kotrace</id>
      <name>Kotrace</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/Kotrace/kotrace.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Kotrace/kotrace.git</developerConnection>
    <url>https://github.com/Kotrace/kotrace</url>
  </scm>
  <properties>
    <kotrace.git.commit>eb03a1534a5761b2a7478c063c5fbdffa215f947</kotrace.git.commit>
  </properties>
  <dependencies>
    <dependency>
      <groupId>dev.kotrace</groupId>
      <artifactId>kotrace</artifactId>
      <version>0.5.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>4.12.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.2.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
